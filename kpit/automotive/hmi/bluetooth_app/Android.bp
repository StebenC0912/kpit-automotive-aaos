package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// -----------------------------------------------------------------------------------------------
// Bluetooth HMI: MVVM UI application (section I, Component 1). Depends only on
// bluetooth-manager-sdk (service/connectivity/bluetooth/Android.bp) - the Activity/ViewModel never
// touch AIDL/Binder directly, only IviBluetoothManager. IviBluetoothManager extends
// BaseConnectivityManager and resolves IviBluetoothService via
// ServiceManager.getService("bluetooth_service") - a restricted @SystemApi - so THIS app must
// itself be privileged/platform-signed (sharedUserId in AndroidManifest.xml + certificate/
// platform_apis below) purely to be allowed to call it. Mirrors hvac_app/Android.bp (VI.6).
// -----------------------------------------------------------------------------------------------
android_app {
    name: "bluetooth-app",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    static_libs: [
        "bluetooth-manager-sdk",
        "androidx.appcompat_appcompat",
        "androidx.cardview_cardview",
        "androidx.lifecycle_lifecycle-viewmodel",
        "androidx.lifecycle_lifecycle-livedata",
        "androidx.annotation_annotation",
    ],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    optimize: {
        enabled: false,
    },
}
