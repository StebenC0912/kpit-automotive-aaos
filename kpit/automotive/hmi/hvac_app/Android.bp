package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// -----------------------------------------------------------------------------------------------
// HVAC HMI: MVVM UI application (section I, Component 1). Depends only on hvac-manager-sdk
// (service/comfort/hvac/Android.bp) - the Activity/ViewModel never touch AIDL/Binder/JNI directly,
// only HvacManager. HvacManager extends BaseComfortManager and resolves HvacService via
// ServiceManager.getService("hvac_service") - a restricted @SystemApi - so THIS app must itself be
// privileged/platform-signed (sharedUserId in AndroidManifest.xml + certificate/platform_apis
// below) purely to be allowed to call it. See instruction.md IV.6 for the tradeoff this implies.
// -----------------------------------------------------------------------------------------------
android_app {
    name: "hvac-app",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    static_libs: [
        "hvac-manager-sdk",
        "androidx.appcompat_appcompat",
        "androidx.lifecycle_lifecycle-viewmodel",
        "androidx.lifecycle_lifecycle-livedata",
        "androidx.annotation_annotation",
    ],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    optimize: {
        enabled: false,
    },
}
