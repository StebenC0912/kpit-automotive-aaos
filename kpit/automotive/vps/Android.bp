package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// -----------------------------------------------------------------------------------------------
// COMPONENT 3 (instruction.md section I.3): the polymorphic Hardware/Middleware layer.
// VpsDispatcher owns zero domain knowledge -- it just routes get/set/subscribe calls by propId to
// whichever registered IVpsHandler (HvacHandler; SeatHandler once Seat is implemented) claims that
// property. Called in-process, directly, from base_comfort_jni's base_comfort_vhal_jni.cpp
// (section II steps 5-6) -- no Binder/HAL service registration involved.
// -----------------------------------------------------------------------------------------------
cc_library_shared {
    name: "libvps",
    export_include_dirs: ["include"],
    srcs: [
        "src/VpsDispatcher.cpp",
        "src/HvacHandler.cpp",
    ],
    shared_libs: [
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
}

// Exercises libvps directly -- HvacHandler and VpsDispatcher -- with no JNI, no Binder, no
// HvacService involved. See kpit/docs/11-testing-hvac.md: the adb `service call hvac_service`
// path already traverses VpsDispatcher, so testing this layer in isolation means going *under*
// HvacService instead, not "through" it. Links against the same libvps.so the device ships.
cc_test {
    name: "libvps_test",
    test_suites: ["device-tests"],
    shared_libs: [
        "libvps",
        "liblog",
    ],
    static_libs: [
        "libgtest",
        "libgtest_main",
    ],
    srcs: [
        "tests/HvacHandlerTest.cpp",
        "tests/VpsDispatcherTest.cpp",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
}
