<?xml version="1.0" encoding="utf-8"?>
<!--
    bluetooth-service (com.kpit.bluetooth) requests two signature|privileged platform
    permissions:
    - BLUETOOTH_PRIVILEGED - needed to obtain the BluetoothHeadsetClient/BluetoothA2dpSink
      proxies and call their hidden methods (instruction.md section V "Required permissions").
    - MEDIA_CONTENT_CONTROL - needed for the AVRCP MediaSessionManager/MediaController path
      (instruction.md section V, added during the BluetoothAvrcpController -> MediaSessionManager
      rework).
    Both are signature|privileged: being system-signed is NOT sufficient on its own for a priv-app
    to hold them. PackageManagerService.systemReady() fatally throws
    IllegalStateException("...not in privapp-permissions allowlist...") and crash-loops
    system_server at boot if either is missing from this allowlist - confirmed 2026-08-02 after
    MEDIA_CONTENT_CONTROL was added to the AndroidManifest but not here.

    Every other KPIT permission (BIND_COMFORT_SERVICE, ACCESS_COMFORT_SERVICE,
    BIND_CONNECTIVITY_SERVICE, ACCESS_CONNECTIVITY_SERVICE, BIND_HVAC_SERVICE,
    BIND_BLUETOOTH_SERVICE) is a custom "signature"-level permission, not
    "signature|privileged" - those are granted automatically to same-signature apps and do not
    go through this allowlist mechanism, so no entry is needed for hvac-app, bluetooth-app,
    hvac-service, or the base-comfort/-connectivity modules.
-->
<permissions>
    <privapp-permissions package="com.kpit.bluetooth">
        <permission name="android.permission.BLUETOOTH_PRIVILEGED" />
        <permission name="android.permission.MEDIA_CONTENT_CONTROL" />
    </privapp-permissions>
</permissions>
